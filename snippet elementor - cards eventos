<style>
  .poster-carousel {
    --card-bg: #12121a;
    --card-border: #1f1f2b;
    --text-main: #f5f5f7;
    --text-sub: #9aa0ab;
    --accent: #00e5ff;
    padding: 12px;
    position: relative;
  }
  .poster-carousel .swiper-slide { width: 260px; }
  .poster-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-shadow: 0 10px 30px rgba(0,0,0,0.25);
    position: relative;
    cursor: pointer;
    transition: transform 0.5s ease, border-color 0.5s ease;
  }
  .poster-card:hover { transform: translateY(-4px); border-color: var(--accent); }
  .poster-card .glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 20% 20%, rgba(0,229,255,0.12), transparent 40%),
                radial-gradient(circle at 80% 30%, rgba(0,229,255,0.1), transparent 45%);
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }
  .poster-card:hover .glow { opacity: 1; }
  .poster-img { position: relative; overflow: hidden; }
  .poster-img img {
    width: 100%;
    height: 230px;
    object-fit: cover;
    display: block;
    transform: scale(1);
    transition: transform 0.7s ease;
  }
  .poster-card:hover .poster-img img { transform: scale(1.1); }
  .poster-img:after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgba(0,0,0,0.5));
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .poster-card:hover .poster-img:after { opacity: 1; }
  .poster-body {
    padding: 12px 14px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    z-index: 1;
  }
  .poster-title { font-weight: 700; color: var(--text-main); font-size: 16px; line-height: 1.3; }
  .poster-sub { color: var(--text-sub); font-size: 12px; line-height: 1.4; }
  .poster-meta { display: grid; grid-template-columns: 1fr; gap: 8px; margin-top: 6px; }
  .poster-meta .label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-sub);
  }
  .poster-meta .value { color: var(--text-main); font-weight: 600; }
  .poster-meta .value span { color: var(--accent); font-weight: 700; }
  .poster-buy {
    margin-top: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 12px;
    border-radius: 12px;
    border: 1px solid var(--card-border);
    background: linear-gradient(90deg, rgba(0,229,255,0.18), rgba(0,229,255,0.08));
    color: var(--text-main);
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }
  .poster-buy:hover { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(0,229,255,0.18); }
  .poster-carousel .swiper-button-prev,
  .poster-carousel .swiper-button-next {
    color: #fff;
    background: rgba(0,0,0,0.35);
    width: 34px;
    height: 34px;
    border-radius: 50%;
  }
  .poster-carousel .swiper-button-prev:after,
  .poster-carousel .swiper-button-next:after { font-size: 16px; }

  /* Modal */
  .poster-modal {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    z-index: 9999;
  }
  .poster-modal.is-open { opacity: 1; pointer-events: auto; }
  .poster-modal__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(4px);
  }
  .poster-modal__dialog {
    position: relative;
    width: min(420px, 90vw);
    background: #0f1118;
    border: 1px solid #1f1f2b;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 20px 70px rgba(0,0,0,0.45);
    transform: translateY(10px) scale(0.98);
    transition: transform 0.3s ease;
  }
  .poster-modal.is-open .poster-modal__dialog { transform: translateY(0) scale(1); }
  .poster-modal__image img { width: 100%; height: 240px; object-fit: cover; display: block; }
  .poster-modal__body { padding: 16px 18px 20px; color: #e9eef5; }
  .poster-modal__tag { text-transform: uppercase; letter-spacing: 0.6px; font-size: 11px; color: var(--accent); margin-bottom: 6px; }
  .poster-modal__subtitle { color: #9aa0ab; margin: 6px 0 10px; font-size: 13px; }
  .poster-modal__text { color: #c2c7d0; font-size: 13px; line-height: 1.5; }
  .poster-modal__close {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(0,0,0,0.6);
    color: #fff;
    border: 1px solid #2a2f3d;
    cursor: pointer;
    transition: background 0.25s ease, transform 0.25s ease;
  }
  .poster-modal__close:hover { background: rgba(0,229,255,0.2); transform: rotate(5deg) scale(1.05); }
  .poster-no-scroll { overflow: hidden; }
</style>

<script>
  const ensureStyle = (id, href) => {
    if (document.getElementById(id)) return Promise.resolve();
    return new Promise((resolve, reject) => {
      const link = document.createElement('link');
      link.id = id;
      link.rel = 'stylesheet';
      link.href = href;
      link.onload = () => resolve();
      link.onerror = (e) => reject(e);
      document.head.appendChild(link);
    });
  };

  const ensureScript = (id, src) => {
    if (document.getElementById(id)) return Promise.resolve();
    return new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.id = id;
      script.src = src;
      script.async = true;
      script.onload = () => resolve();
      script.onerror = (e) => reject(e);
      document.head.appendChild(script);
    });
  };

  const slidesEl = document.getElementById('eventSlides');
  const modal = document.getElementById('posterModal');
  const modalImage = document.getElementById('modalImage');
  const modalTitle = document.getElementById('modalTitle');
  const modalVenue = document.getElementById('modalVenue');
  const modalMeta = document.getElementById('modalMeta');

  const initSwiper = () => new Swiper('#eventCarousel', {
    slidesPerView: 'auto',
    spaceBetween: 12,
    grabCursor: true,
    navigation: {
      nextEl: '.poster-carousel .swiper-button-next',
      prevEl: '.poster-carousel .swiper-button-prev',
    },
    breakpoints: {
      0:   { slidesPerView: 1.2, spaceBetween: 10 },
      480: { slidesPerView: 2.1, spaceBetween: 10 },
      768: { slidesPerView: 3.1, spaceBetween: 12 },
      1024:{ slidesPerView: 4.2, spaceBetween: 12 },
      1280:{ slidesPerView: 5.2, spaceBetween: 12 },
    }
  });

  const initModal = () => {
    slidesEl.addEventListener('click', (e) => {
      const card = e.target.closest('.poster-card');
      if (!card) return;
      modalImage.src = card.dataset.image;
      modalImage.alt = card.dataset.title;
      modalTitle.textContent = card.dataset.title;
      modalVenue.textContent = card.dataset.venue;
      modalMeta.textContent = card.dataset.meta;
      modal.classList.add('is-open');
      document.body.classList.add('poster-no-scroll');
      modal.setAttribute('aria-hidden', 'false');
    });

    const closeModal = () => {
      modal.classList.remove('is-open');
      document.body.classList.remove('poster-no-scroll');
      modal.setAttribute('aria-hidden', 'true');
    };

    modal.addEventListener('click', (e) => {
      if (e.target.dataset.close !== undefined || e.target === modal) {
        closeModal();
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
    });
  };

  const bootstrap = async () => {
    try {
      await ensureStyle('poster-swiper-css', 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css');
      if (typeof Swiper === 'undefined') {
        await ensureScript('poster-swiper-js', 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js');
      }
      initSwiper();
      initModal();
    } catch (err) {
      console.error('No se pudo inicializar el carrusel:', err);
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootstrap);
  } else {
    bootstrap();
  }
</script>
